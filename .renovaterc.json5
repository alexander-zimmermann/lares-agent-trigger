{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alexander-zimmermann/lares//.renovate/sidecarBase.json5",
    "github>alexander-zimmermann/lares//.renovate/sidecarPython.json5",
    "github>alexander-zimmermann/lares//.renovate/sidecarCoreDep.json5",
  ],
  "customManagers": [
    {
      // The gateway test runs the gateway and the GitHub server lares deploys
      "customType": "regex",
      "managerFilePatterns": ["/^tests/test_gateway\\.py$/"],
      "matchStrings": ["_IMAGE = \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker",
    },
  ],
}
